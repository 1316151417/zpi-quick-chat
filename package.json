{
  "name": "zpi-quick-chat",
  "version": "0.1.0",
  "description": "A small floating DeepSeek chat powered by zpi-agent-sdk",
  "type": "module",
  "bin": {
    "zpi-quick-chat": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "dist",
    "vendor",
    "README.md",
    "NOTICE",
    "docs"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:desktop": "node scripts/test-desktop.mjs",
    "start": "node bin/cli.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "electron": "41.10.7",
    "zpi-agent-sdk": "file:vendor/zpi-agent-sdk-0.1.60.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "esbuild": "0.27.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "bundleDependencies": [
    "zpi-agent-sdk"
  ]
}
