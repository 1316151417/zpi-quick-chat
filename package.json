{
  "name": "@zpi-dev/quick-chat",
  "version": "0.1.1",
  "description": "A small floating DeepSeek chat powered by @zpi-dev/agent-sdk",
  "type": "module",
  "bin": {
    "zpi-quick-chat": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "NOTICE",
    "docs"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:desktop": "node scripts/test-desktop.mjs",
    "start": "node bin/cli.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@zpi-dev/agent-sdk": "0.1.61",
    "electron": "41.10.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "esbuild": "0.27.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1316151417/zpi-quick-chat.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
